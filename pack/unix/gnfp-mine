#!/bin/sh
DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
if ! command -v node >/dev/null 2>&1; then
  echo "gnfp-mine: Node.js 18+ is required (the node command was not on PATH)." >&2
  echo "Install Node.js 18+ from https://nodejs.org then retry. That install includes npm — you do not npm install this miner." >&2
  echo "  macOS: brew install node    Windows: https://nodejs.org    Linux: nodejs.org or your package manager" >&2
  exit 1
fi
exec node "$DIR/src/miner.js" "$@"
